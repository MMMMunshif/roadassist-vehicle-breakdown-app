    }

    match /providerDirectory/{providerId} {
      allow read: if isAdmin();
      allow update: if isAdmin() && accountBlockedAfter(providerId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['online','updatedAt'])
        && request.resource.data.online == false && request.resource.data.updatedAt == request.time;
      function accountBlockedAfter(uid) {
        let data = getAfter(/databases/$(database)/documents/accountModeration/$(uid)).data;
        return data.status == 'suspended' || data.verification != 'verified';
      }
      allow read: if signedIn();
      allow create, update: if signedIn()
        && isProvider()
        && request.auth.uid == providerId
        && request.resource.data.keys().hasOnly([
