rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isProvider() {
      return signedIn() && userRole() == 'provider';
    }

    function isDriver() {
      return signedIn() && userRole() == 'driver';
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
      allow delete: if signedIn() && request.auth.uid == userId;

      match /devices/{deviceId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
      match /vehicles/{vehicleId} {
        function ownsVehicle() {
          return signedIn() && request.auth.uid == userId && isDriver();
        }
        function validVehicle() {
          let v = request.resource.data;
          return v.keys().hasAll(['make', 'model', 'year', 'vehicleType',
              'registration', 'fuelType', 'transmission', 'archived', 'createdAt', 'updatedAt'])
            && v.keys().hasOnly(['make', 'model', 'year', 'vehicleType',
              'registration', 'fuelType', 'transmission', 'archived', 'createdAt', 'updatedAt'])
            && v.make is string && v.make.size() > 0 && v.make.size() <= 40
            && v.model is string && v.model.size() > 0 && v.model.size() <= 40
            && v.year is int && v.year >= 1950 && v.year <= request.time.year() + 1
            && v.vehicleType in ['Sedan / Hatchback', 'SUV', 'Van', 'Motorcycle', 'Other']
            && v.registration is string && v.registration.size() > 0 && v.registration.size() <= 16
            && v.fuelType in ['Petrol', 'Diesel', 'Hybrid', 'Electric', 'Other']
            && v.transmission in ['Automatic', 'Manual', 'Other']
            && v.archived is bool && v.createdAt is timestamp
            && v.updatedAt == request.time;
        }
        allow read: if ownsVehicle();
        allow create: if ownsVehicle() && validVehicle() && request.resource.data.createdAt == request.time;
        allow update: if ownsVehicle() && validVehicle()
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }
    }

    match /providerDirectory/{providerId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && isProvider()
        && request.auth.uid == providerId
        && request.resource.data.keys().hasOnly([
          'displayName', 'online', 'services', 'serviceRadius', 'latitude',
          'longitude', 'completedJobs', 'averageRating',
          'averageResponseMinutes', 'locationUpdatedAt', 'updatedAt', 'activeRequestId'
        ])
        && (resource == null
          ? !('activeRequestId' in request.resource.data)
          : (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['activeRequestId'])
            || (request.resource.data.activeRequestId is string
              && (!('activeRequestId' in resource.data) || resource.data.activeRequestId == null)
              && getAfter(/databases/$(database)/documents/requests/$(request.resource.data.activeRequestId)).data.providerId == providerId
              && getAfter(/databases/$(database)/documents/requests/$(request.resource.data.activeRequestId)).data.status in ['accepted', 'en_route', 'arrived'])
            || (request.resource.data.activeRequestId == null
              && resource.data.activeRequestId is string
              && getAfter(/databases/$(database)/documents/requests/$(resource.data.activeRequestId)).data.providerId == providerId
              && getAfter(/databases/$(database)/documents/requests/$(resource.data.activeRequestId)).data.status in ['completed', 'cancelled'])));
      // A driver may atomically reserve the provider only with an approved quote.
      allow update: if isDriver()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeRequestId'])
        && ((request.resource.data.activeRequestId is string
          && request.resource.data.activeRequestId.size() > 0
          && (!('activeRequestId' in resource.data) || resource.data.activeRequestId == null || resource.data.activeRequestId == '')
          && resource.data.online == true
          && get(/databases/$(database)/documents/requests/$(request.resource.data.activeRequestId)).data.status == 'searching'
          && getAfter(/databases/$(database)/documents/requests/$(request.resource.data.activeRequestId)).data.driverId == request.auth.uid
          && getAfter(/databases/$(database)/documents/requests/$(request.resource.data.activeRequestId)).data.providerId == providerId
          && getAfter(/databases/$(database)/documents/requests/$(request.resource.data.activeRequestId)).data.status == 'accepted')
          || (request.resource.data.activeRequestId == null
            && resource.data.activeRequestId is string
            && getAfter(/databases/$(database)/documents/requests/$(resource.data.activeRequestId)).data.driverId == request.auth.uid
            && getAfter(/databases/$(database)/documents/requests/$(resource.data.activeRequestId)).data.status == 'cancelled'));
      allow delete: if signedIn()
        && isProvider()
        && request.auth.uid == providerId
        && (!('activeRequestId' in resource.data) || resource.data.activeRequestId == null);
    }

    match /requests/{requestId} {
      allow create: if signedIn()
        && isDriver()
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.providerId == null
        && request.resource.data.status == 'searching'
        && (!('workflowVersion' in request.resource.data) || request.resource.data.workflowVersion == 2)
        && (!('vehicleId' in request.resource.data)
          || (request.resource.data.vehicleId is string
            && exists(/databases/$(database)/documents/users/$(request.auth.uid)/vehicles/$(request.resource.data.vehicleId))))
        && (!('vehicleSnapshot' in request.resource.data)
          || (request.resource.data.vehicleSnapshot is map
            && request.resource.data.vehicleSnapshot.keys().hasOnly(['make','model','year','vehicleType','registration','fuelType','transmission','modelYear'])))
        && (!('partsPreference' in request.resource.data) || request.resource.data.partsPreference in ['discuss','budget','branded','genuine'])
        && request.resource.data.issue in [
          'Vehicle Towing', 'Battery Jumpstart', 'Flat Tyre',
          'General Mechanic'
        ]
        && request.resource.data.issues is list
        && request.resource.data.issues.size() >= 1
        && request.resource.data.issues.size() <= 4
        && request.resource.data.issues.hasOnly([
          'Vehicle Towing', 'Battery Jumpstart', 'Flat Tyre',
          'General Mechanic'
        ])
        && request.resource.data.vehicleType is string
        && request.resource.data.modelYear is string
        && request.resource.data.modelYear.size() <= 50
        && request.resource.data.registration is string
        && request.resource.data.registration.size() <= 16
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 0
        && request.resource.data.description.size() <= 500
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 300
        && request.resource.data.priority in [
          'normal', 'urgent', 'road_blocking', 'safety_risk'
        ]
        && request.resource.data.vehiclePhotoUrls is list
        && request.resource.data.vehiclePhotoUrls.size() <= 3
        && request.resource.data.photoAnnotations is list
        && request.resource.data.photoAnnotations.size() <= 3
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.landmark is string
        && request.resource.data.landmark.size() <= 120
        && (request.resource.data.locationAccuracyMeters == null
          || request.resource.data.locationAccuracyMeters is number)
        && request.resource.data.serviceFee is int
        && request.resource.data.serviceFee >= 0
        && request.resource.data.dispatchFee is int
        && request.resource.data.dispatchFee >= 0
        && request.resource.data.estimatedCost is int
        && request.resource.data.estimatedCost ==
          request.resource.data.serviceFee + request.resource.data.dispatchFee
        && (!('workflowVersion' in request.resource.data)
          || request.resource.data.estimatedCost == 0)
        && request.resource.data.preferredProviderId is string
        && request.resource.data.rejectedBy is list
        && request.resource.data.rejectedBy.size() == 0
        && request.resource.data.keys().hasOnly([
          'driverId', 'driverName', 'driverPhone', 'providerId',
          'preferredProviderId', 'preferredProviderName', 'rejectedBy',
          'status', 'issue', 'issues', 'vehicleType', 'modelYear', 'registration',
          'vehicleId', 'vehicleSnapshot', 'workflowVersion', 'partsPreference',
          'description', 'notes', 'priority', 'vehiclePhotoUrls',
          'photoAnnotations', 'locationLabel', 'landmark',
          'locationAccuracyMeters', 'latitude', 'longitude', 'serviceFee', 'dispatchFee',
          'estimatedCost', 'createdAt', 'updatedAt'
        ]);

      allow read: if signedIn() && (
        resource.data.driverId == request.auth.uid
        || resource.data.providerId == request.auth.uid
        || (isProvider() && resource.data.status == 'searching')
      );

      allow update: if signedIn() && (
        (resource.data.status == 'completed'
          && resource.data.driverId == request.auth.uid
          && (!('driverReportedPayment' in resource.data) || resource.data.driverReportedPayment != true)
          && request.resource.data.driverReportedPayment == true
          && request.resource.data.paymentMethod in ['cash','external']
          && request.resource.data.paymentReportedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['driverReportedPayment','paymentMethod','paymentReportedAt']))
        || (resource.data.status == 'completed' && resource.data.providerId == request.auth.uid
          && resource.data.driverReportedPayment == true
          && (!('providerConfirmedPayment' in resource.data) || resource.data.providerConfirmedPayment != true)
          && request.resource.data.providerConfirmedPayment == true
          && request.resource.data.paymentConfirmedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['providerConfirmedPayment','paymentConfirmedAt']))
        ||
        (resource.data.driverId == request.auth.uid
          && resource.data.status == 'searching'
          && resource.data.workflowVersion == 2
          && request.resource.data.status == 'accepted'
          && request.resource.data.providerId == request.resource.data.selectedQuoteId
          && (resource.data.preferredProviderId == '' || resource.data.preferredProviderId == request.resource.data.providerId)
          && get(/databases/$(database)/documents/requests/$(requestId)/quotes/$(request.resource.data.selectedQuoteId)).data.providerId == request.resource.data.providerId
          && get(/databases/$(database)/documents/requests/$(requestId)/quotes/$(request.resource.data.selectedQuoteId)).data.providerName == request.resource.data.providerName
          && get(/databases/$(database)/documents/requests/$(requestId)/quotes/$(request.resource.data.selectedQuoteId)).data.providerPhone == request.resource.data.providerPhone
          && get(/databases/$(database)/documents/requests/$(requestId)/quotes/$(request.resource.data.selectedQuoteId)).data.notes == request.resource.data.quoteNotes
          && get(/databases/$(database)/documents/requests/$(requestId)/quotes/$(request.resource.data.selectedQuoteId)).data.providerDistanceKm == request.resource.data.providerDistanceKm
          && get(/databases/$(database)/documents/requests/$(requestId)/quotes/$(request.resource.data.selectedQuoteId)).data.total == request.resource.data.estimatedCost
          && get(/databases/$(database)/documents/requests/$(requestId)/quotes/$(request.resource.data.selectedQuoteId)).data.serviceFee == request.resource.data.serviceFee
          && get(/databases/$(database)/documents/requests/$(requestId)/quotes/$(request.resource.data.selectedQuoteId)).data.travelFee == request.resource.data.dispatchFee
          && get(/databases/$(database)/documents/requests/$(requestId)/quotes/$(request.resource.data.selectedQuoteId)).data.extraFee == request.resource.data.extraFee
          && get(/databases/$(database)/documents/requests/$(requestId)/quotes/$(request.resource.data.selectedQuoteId)).data.quoteType == request.resource.data.approvedQuoteType
          && getAfter(/databases/$(database)/documents/providerDirectory/$(request.resource.data.providerId)).data.activeRequestId == requestId
          && request.resource.data.quoteApprovedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'providerId', 'providerName', 'providerPhone', 'status', 'selectedQuoteId', 'serviceFee',
            'dispatchFee', 'extraFee', 'estimatedCost', 'quoteNotes', 'providerDistanceKm',
            'quoteApprovedAt', 'acceptedAt', 'updatedAt', 'approvedQuoteType'
          ]))
        || (resource.data.providerId == request.auth.uid
          && resource.data.workflowVersion == 2 && resource.data.status == 'arrived'
          && request.resource.data.pendingRepairId is string
          && getAfter(/databases/$(database)/documents/requests/$(requestId)/repairQuotes/$(request.resource.data.pendingRepairId)).data.providerId == request.auth.uid
          && getAfter(/databases/$(database)/documents/requests/$(requestId)/repairQuotes/$(request.resource.data.pendingRepairId)).data.createdAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingRepairId', 'updatedAt']))
        || (resource.data.driverId == request.auth.uid
          && resource.data.workflowVersion == 2 && resource.data.status == 'arrived'
          && resource.data.pendingRepairId is string
          && request.resource.data.pendingRepairId == null
          && request.resource.data.lastRepairDecisionId == resource.data.pendingRepairId
          && request.resource.data.repairDecisionAt == request.time
          && ((request.resource.data.lastRepairDecision == 'rejected'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'pendingRepairId', 'lastRepairDecisionId', 'lastRepairDecision', 'repairDecisionAt', 'updatedAt']))
            || (request.resource.data.lastRepairDecision == 'approved'
              && request.resource.data.approvedRepairId == resource.data.pendingRepairId
              && get(/databases/$(database)/documents/requests/$(requestId)/repairQuotes/$(resource.data.pendingRepairId)).data.previousTotal == resource.data.estimatedCost
              && get(/databases/$(database)/documents/requests/$(requestId)/repairQuotes/$(resource.data.pendingRepairId)).data.total == request.resource.data.estimatedCost
              && get(/databases/$(database)/documents/requests/$(requestId)/repairQuotes/$(resource.data.pendingRepairId)).data.serviceFee == request.resource.data.serviceFee
              && get(/databases/$(database)/documents/requests/$(requestId)/repairQuotes/$(resource.data.pendingRepairId)).data.travelFee == request.resource.data.dispatchFee
              && get(/databases/$(database)/documents/requests/$(requestId)/repairQuotes/$(resource.data.pendingRepairId)).data.extraFee == request.resource.data.extraFee
              && get(/databases/$(database)/documents/requests/$(requestId)/repairQuotes/$(resource.data.pendingRepairId)).data.diagnosisAndWork == request.resource.data.providerDiagnosis
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'pendingRepairId', 'lastRepairDecisionId', 'lastRepairDecision', 'repairDecisionAt', 'updatedAt',
                'approvedRepairId', 'estimatedCost', 'serviceFee', 'dispatchFee', 'extraFee', 'providerDiagnosis']))))
        ||
        // A driver may only cancel their own active request.
        (resource.data.driverId == request.auth.uid
          && resource.data.status in ['searching', 'accepted', 'en_route', 'arrived']
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'cancelledAt', 'updatedAt'
          ]))
        // A driver may rate only their own completed request.
        || (resource.data.driverId == request.auth.uid
          && resource.data.status == 'completed'
          && request.resource.data.driverRating is int
          && request.resource.data.driverRating >= 1
          && request.resource.data.driverRating <= 5
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'driverRating', 'ratedAt', 'updatedAt'
          ]))
        // A driver may correct request details until a provider accepts it.
        || (resource.data.driverId == request.auth.uid
          && resource.data.status == 'searching'
          && resource.data.providerId == null
          && request.resource.data.status == 'searching'
          && request.resource.data.description is string
          && request.resource.data.description.size() >= 0
          && request.resource.data.description.size() <= 500
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 300
          && request.resource.data.landmark is string
          && request.resource.data.landmark.size() <= 120
          && request.resource.data.vehiclePhotoUrls is list
          && request.resource.data.vehiclePhotoUrls.size() <= 3
          && request.resource.data.latitude is number
          && request.resource.data.longitude is number
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'description', 'notes', 'vehiclePhotoUrls', 'photoAnnotations',
            'locationLabel', 'landmark', 'locationAccuracyMeters',
            'latitude', 'longitude', 'updatedAt'
          ]))
        // Chat read timestamp for the driver.
        || (resource.data.driverId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'driverMessagesSeenAt'
          ]))
        // Driver can broaden an unanswered targeted request to all providers.
        || (resource.data.driverId == request.auth.uid
          && resource.data.status == 'searching'
          && request.resource.data.status == 'searching'
          && request.resource.data.preferredProviderId == ''
          && request.resource.data.preferredProviderName == ''
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'preferredProviderId', 'preferredProviderName',
            'fallbackStartedAt', 'updatedAt'
          ]))
        // Only one transaction can move a still-searching request to accepted.
        || (isProvider()
          && (!('workflowVersion' in resource.data) || resource.data.workflowVersion != 2)
          && resource.data.status == 'searching'
          && resource.data.providerId == null
          && (!('preferredProviderId' in resource.data)
            || resource.data.preferredProviderId == ''
            || resource.data.preferredProviderId == request.auth.uid)
          && request.resource.data.providerId == request.auth.uid
          && request.resource.data.status == 'accepted'
          && request.resource.data.serviceFee is int
          && request.resource.data.serviceFee >= 0
          && request.resource.data.dispatchFee is int
          && request.resource.data.dispatchFee >= 0
          && request.resource.data.extraFee is int
          && request.resource.data.extraFee >= 0
          && request.resource.data.providerDistanceKm is number
          && request.resource.data.providerDistanceKm >= 0
          && request.resource.data.quoteNotes is string
          && request.resource.data.quoteNotes.size() <= 200
          && request.resource.data.estimatedCost ==
            request.resource.data.serviceFee
            + request.resource.data.dispatchFee
            + request.resource.data.extraFee
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'providerId', 'providerName', 'providerPhone', 'status',
            'serviceFee', 'dispatchFee', 'extraFee', 'estimatedCost',
            'providerDistanceKm', 'quoteNotes', 'quotedAt',
            'acceptedAt', 'updatedAt'
          ]))
        // A provider can dismiss an open request only for themselves.
        || (isProvider()
          && resource.data.status == 'searching'
          && (!('preferredProviderId' in resource.data)
            || resource.data.preferredProviderId == ''
            || resource.data.preferredProviderId == request.auth.uid)
          && request.resource.data.status == 'searching'
          && request.resource.data.rejectedBy.hasAll(resource.data.rejectedBy)
          && request.resource.data.rejectedBy.hasAll([request.auth.uid])
          && (!('preferredProviderId' in request.resource.data)
            || request.resource.data.preferredProviderId == '')
          && (!('preferredProviderName' in request.resource.data)
            || request.resource.data.preferredProviderName == '')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'rejectedBy', 'preferredProviderId', 'preferredProviderName',
            'fallbackStartedAt', 'updatedAt'
          ]))
        // Assigned provider: strict job-status progression.
        || (resource.data.providerId == request.auth.uid
          && ((resource.data.status == 'accepted'
                && request.resource.data.status == 'en_route')
            || (resource.data.status == 'en_route'
                && request.resource.data.status == 'arrived')
            || (resource.data.status == 'arrived'
                && request.resource.data.status == 'completed'))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'en_routeAt', 'arrivedAt', 'completedAt', 'finalCost',
            'updatedAt'
          ])
          && (request.resource.data.status != 'completed'
            || (request.resource.data.finalCost is int
              && request.resource.data.finalCost >= 0
              && (!('workflowVersion' in resource.data) || resource.data.workflowVersion != 2
                || (request.resource.data.finalCost <= resource.data.estimatedCost
                  && (!('pendingRepairId' in resource.data) || resource.data.pendingRepairId == null)
                  && (resource.data.approvedQuoteType != 'inspection' || resource.data.approvedRepairId is string))))))
        // Assigned provider live update their live coordinates.
        || (resource.data.providerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'providerLatitude', 'providerLongitude',
            'providerLocationUpdatedAt'
          ]))
        // Assigned provider can add service notes and compressed evidence photos.
        || (resource.data.providerId == request.auth.uid
          && resource.data.status in ['accepted', 'en_route', 'arrived']
          && request.resource.data.serviceNotes is string
          && request.resource.data.serviceNotes.size() <= 500
          && request.resource.data.servicePhotoData is list
          && request.resource.data.servicePhotoData.size() <= 3
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'serviceNotes', 'servicePhotoData',
            'documentationUpdatedAt'
          ]))
        // Chat read timestamp for the assigned provider.
        || (resource.data.providerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'providerMessagesSeenAt'
          ]))
      );
      allow delete: if false;

      match /quotes/{providerId} {
        function parent() {
          return get(/databases/$(database)/documents/requests/$(requestId)).data;
        }
        allow read: if signedIn() && (parent().driverId == request.auth.uid || request.auth.uid == providerId);
        allow create, update: if isProvider() && providerId == request.auth.uid
          && parent().status == 'searching' && parent().workflowVersion == 2
          && (parent().preferredProviderId == '' || parent().preferredProviderId == providerId)
          && !parent().rejectedBy.hasAny([providerId])
          && request.resource.data.keys().hasOnly(['providerId', 'providerName', 'providerPhone',
            'serviceFee', 'travelFee', 'extraFee', 'total', 'notes', 'providerDistanceKm', 'createdAt', 'quoteType'])
          && request.resource.data.quoteType in ['direct', 'inspection']
          && request.resource.data.providerId == providerId
          && request.resource.data.providerName is string
          && request.resource.data.providerPhone is string
          && request.resource.data.serviceFee is int && request.resource.data.serviceFee >= 0
          && request.resource.data.travelFee is int && request.resource.data.travelFee >= 0
          && request.resource.data.extraFee is int && request.resource.data.extraFee >= 0
          && request.resource.data.total == request.resource.data.serviceFee + request.resource.data.travelFee + request.resource.data.extraFee
          && request.resource.data.total <= 10000000
          && request.resource.data.notes is string && request.resource.data.notes.size() <= 200
          && request.resource.data.providerDistanceKm is number && request.resource.data.providerDistanceKm >= 0
          && request.resource.data.createdAt == request.time;
        allow delete: if false;
      }
      match /repairQuotes/{revisionId} {
        function job() { return get(/databases/$(database)/documents/requests/$(requestId)).data; }
        allow read: if signedIn() && (job().driverId == request.auth.uid || job().providerId == request.auth.uid);
        allow create: if isProvider() && job().providerId == request.auth.uid
          && job().workflowVersion == 2 && job().status == 'arrived'
          && request.resource.data.keys().hasOnly(['providerId', 'previousTotal', 'serviceFee', 'travelFee', 'extraFee', 'total', 'diagnosisAndWork', 'changeReason', 'evidencePhotoData', 'createdAt'])
          && request.resource.data.providerId == request.auth.uid
          && (!('pendingRepairId' in job()) || job().pendingRepairId == null)
          && request.resource.data.changeReason is string
          && request.resource.data.changeReason.size() >= 10 && request.resource.data.changeReason.size() <= 300
          && request.resource.data.evidencePhotoData is list && request.resource.data.evidencePhotoData.size() <= 2
          && (request.resource.data.total <= job().estimatedCost || request.resource.data.evidencePhotoData.size() > 0)
          && (request.resource.data.evidencePhotoData.size() < 1 || (request.resource.data.evidencePhotoData[0] is string && request.resource.data.evidencePhotoData[0].size() > 0 && request.resource.data.evidencePhotoData[0].size() <= 210000))
          && (request.resource.data.evidencePhotoData.size() < 2 || (request.resource.data.evidencePhotoData[1] is string && request.resource.data.evidencePhotoData[1].size() > 0 && request.resource.data.evidencePhotoData[1].size() <= 210000))
          && request.resource.data.previousTotal == job().estimatedCost
          && request.resource.data.serviceFee is int && request.resource.data.serviceFee >= 0
          && request.resource.data.travelFee is int && request.resource.data.travelFee >= 0
          && request.resource.data.extraFee is int && request.resource.data.extraFee >= 0
          && request.resource.data.total == request.resource.data.serviceFee + request.resource.data.travelFee + request.resource.data.extraFee
          && request.resource.data.total <= 10000000
          && request.resource.data.diagnosisAndWork is string
          && request.resource.data.diagnosisAndWork.size() > 0 && request.resource.data.diagnosisAndWork.size() <= 200
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/requests/$(requestId)).data.pendingRepairId == revisionId;
        allow update, delete: if false;
      }
      match /repairDecisions/{revisionId} {
        function job() { return get(/databases/$(database)/documents/requests/$(requestId)).data; }
        allow read: if signedIn() && (job().driverId == request.auth.uid || job().providerId == request.auth.uid);
        allow create: if signedIn() && job().driverId == request.auth.uid
          && job().pendingRepairId == revisionId
          && request.resource.data.keys().hasOnly(['driverId','decision','createdAt'])
          && request.resource.data.driverId == request.auth.uid
          && request.resource.data.decision in ['approved','rejected']
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/requests/$(requestId)).data.lastRepairDecisionId == revisionId
          && getAfter(/databases/$(database)/documents/requests/$(requestId)).data.lastRepairDecision == request.resource.data.decision;
        allow update,delete: if false;
      }

      match /disputes/{caseId} {
        function job() { return get(/databases/$(database)/documents/requests/$(requestId)).data; }
        function participant() { return signedIn() && (job().driverId == request.auth.uid || job().providerId == request.auth.uid); }
        function validPhotos(p) {
          return p is list && p.size() <= 2
            && (p.size() < 1 || (p[0] is string && p[0].size() > 0 && p[0].size() <= 210000))
            && (p.size() < 2 || (p[1] is string && p[1].size() > 0 && p[1].size() <= 210000));
        }
        allow read: if participant();
        allow create: if participant() && caseId == 'case' && job().status == 'completed'
          && job().driverId == request.auth.uid && job().providerId is string
          && request.resource.data.keys().hasAll(['driverId','providerId','reason','description','photos','status','providerResponse','resolution','approvedTotal','finalTotal','createdAt','updatedAt'])
          && request.resource.data.keys().hasOnly(['driverId','providerId','reason','description','photos','status','providerResponse','resolution','approvedTotal','finalTotal','createdAt','updatedAt'])
          && request.resource.data.driverId == job().driverId && request.resource.data.providerId == job().providerId
          && request.resource.data.reason in ['extra_charge','repair_quality','incomplete_service','other']
          && request.resource.data.description is string && request.resource.data.description.size() >= 10 && request.resource.data.description.size() <= 1000
          && validPhotos(request.resource.data.photos)
          && request.resource.data.status == 'open' && request.resource.data.providerResponse == '' && request.resource.data.resolution == ''
          && request.resource.data.approvedTotal == job().get('estimatedCost', 0)
          && request.resource.data.finalTotal == job().get('finalCost', job().get('estimatedCost', 0))
          && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
        allow update: if participant() && resource.data.status != 'resolved' && request.resource.data.updatedAt == request.time && (
          (job().providerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['providerResponse','status','updatedAt'])
            && request.resource.data.providerResponse is string && request.resource.data.providerResponse.size() >= 10 && request.resource.data.providerResponse.size() <= 1000
            && request.resource.data.status == 'under_review')
          || (job().driverId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolution','updatedAt'])
            && request.resource.data.status == 'resolved' && request.resource.data.resolution == 'Driver confirmed the problem is resolved.')
        );
        allow delete: if false;
      }
      match /messages/{messageId} {
        function parentRequest() {
          return get(/databases/$(database)/documents/requests/$(requestId)).data;
        }
        allow read: if signedIn() && (
          parentRequest().driverId == request.auth.uid
          || parentRequest().providerId == request.auth.uid
        );
        allow create: if signedIn()
          && (parentRequest().driverId == request.auth.uid
            || parentRequest().providerId == request.auth.uid)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && ((request.resource.data.text.size() > 0)
            || (request.resource.data.imageData is string
              && request.resource.data.imageData.size() > 0
              && request.resource.data.imageData.size() <= 250000))
          && request.resource.data.keys().hasOnly([
            'senderId', 'text', 'imageData', 'createdAt'
          ]);
        allow update, delete: if false;
      }
    }
  }
}
