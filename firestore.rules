rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return authenticated() && !accountBlocked(request.auth.uid)
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && request.auth.token.get('email_verified', false) == true
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role != 'provider'
          || providerApproved(request.auth.uid)
          || 'driver' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('roles', []));
    }

    function hasRole(uid, role) {
      let profile = get(/databases/$(database)/documents/users/$(uid)).data;
      return profile.role == role || role in profile.get('roles', []);
    }

    function authenticated() { return request.auth != null; }
    function accountBlocked(uid) {
      let path = /databases/$(database)/documents/accountModeration/$(uid);
      return exists(path) && (get(path).data.status == 'suspended' || get(path).data.verification == 'rejected');
    }
    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true
        && request.auth.token.get('email_verified', false) == true
        && exists(/databases/$(database)/documents/adminAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminAccess/$(request.auth.uid)).data.enabled == true;
    }
    function providerApproved(uid) {
      let m = /databases/$(database)/documents/accountModeration/$(uid);
      let a = /databases/$(database)/documents/providerApplications/$(uid);
      return exists(m) && exists(a) && get(m).data.verification == 'verified'
        && get(m).data.status == 'active'
        && get(m).data.get('verificationRevision', 0) == get(a).data.revision
        && get(m).data.get('validUntil', request.time) > request.time
        && get(a).data.get('applicationStatus', 'submitted') != 'withdrawn'
        && get(a).data.get('professionalDetails', {}).keys().hasAll(['workHistory','qualification','tools','businessPhone']);
    }
    function adminRole() {
      return get(/databases/$(database)/documents/adminAccess/$(request.auth.uid)).data.get('role', 'super_admin');
    }
    function canReviewProviders() { return isAdmin() && adminRole() in ['super_admin','reviewer']; }
    function canSupport() { return isAdmin() && adminRole() in ['super_admin','support']; }
    function superAdmin() { return isAdmin() && adminRole() == 'super_admin'; }
    function newRequestsAllowed(issues) {
      let p = /databases/$(database)/documents/appSettings/operations;
      return !exists(p) || (get(p).data.maintenance == false && issues.hasOnly(get(p).data.enabledServices));
    }
    function availableForRequests(d) {
      let minute = (request.time.hours() * 60 + request.time.minutes() + 330) % 1440;
      let start = d.get('workStartMinute',0);
      let end = d.get('workEndMinute',0);
      return d.online == true && d.get('requestsPaused',false) == false
        && d.get('activeRequestId',null) == null
        && (d.get('available24Hours',false) || !d.get('scheduleConfigured',false)
          || d.get('hoursOverrideUntil',request.time) > request.time
          || (start < end ? minute >= start && minute < end : start > end && (minute >= start || minute < end)));
    }
    function validProfessional(p, services) {
      return p is map
        && p.keys().hasAll(['providerType','businessPhone','businessRegistration','workHistory','qualification','trainingInstitute','qualificationYear','specializations','coverageAreas','radiusKm','startTime','endTime','towRegistration','towCapacityKg','insuranceDetails','available24Hours','languages','workDays','tools'])
        && p.keys().hasOnly(['providerType','businessPhone','businessRegistration','workHistory','qualification','trainingInstitute','qualificationYear','specializations','coverageAreas','radiusKm','startTime','endTime','towRegistration','towCapacityKg','insuranceDetails','available24Hours','languages','workDays','tools'])
        && p.providerType in ['independent','business']
        && p.businessPhone is string && p.businessPhone.matches('[+]947[0-9]{8}')
        && p.businessRegistration is string && p.businessRegistration.size() <= 60 && (p.providerType != 'business' || p.businessRegistration.size() >= 3)
        && p.workHistory is string && (p.workHistory.size() == 0 || p.workHistory.size() >= 10) && p.workHistory.size() <= 1000
        && p.qualification is string && p.qualification.size() <= 150
        && p.trainingInstitute is string && p.trainingInstitute.size() <= 150
        && p.qualificationYear is int && (p.qualificationYear == 0 || (p.qualificationYear >= 1950 && p.qualificationYear <= request.time.year()))
        && p.specializations is string && p.specializations.size() <= 300
        && p.coverageAreas is string && p.coverageAreas.size() <= 300
        && p.radiusKm is int && p.radiusKm >= 1 && p.radiusKm <= 100
        && p.available24Hours is bool && p.startTime is string && p.endTime is string
        && ((p.startTime == '' && p.endTime == '') || (p.startTime.matches('([01][0-9]|2[0-3]):[0-5][0-9]') && p.endTime.matches('([01][0-9]|2[0-3]):[0-5][0-9]')))
        && p.languages is list && p.languages.size() <= 3 && p.languages.hasOnly(['English','Sinhala','Tamil'])
        && p.workDays is list && p.workDays.size() <= 7 && p.workDays.hasOnly(['Mon','Tue','Wed','Thu','Fri','Sat','Sun'])
        && p.tools is list && p.tools.size() <= 8 && p.tools.hasOnly(['Hand tools','Jack and stands','Tyre repair kit','Jump starter','Diagnostic scanner','Recovery truck','Winch','Safety equipment'])
        && p.insuranceDetails is string && p.insuranceDetails.size() <= 300
        && p.towRegistration is string && p.towRegistration.size() <= 20 && p.towCapacityKg is int && p.towCapacityKg >= 0 && p.towCapacityKg <= 30000
        && (!services.hasAny(['Vehicle Towing']) || (p.towRegistration.size() >= 3 && p.towCapacityKg >= 500));
    }

    match /providerApplications/{uid} {
      function owner() { return authenticated() && request.auth.uid == uid && !accountBlocked(uid)
        && hasRole(uid, 'provider'); }
      function valid() {
        let d = request.resource.data;
        return request.auth.token.get('email_verified', false) == true
          && d.keys().hasAll(['legalName','nicNumber','address','businessName','emergencyPhone','experienceYears','services','vehicleTypes','documents','revision','submittedAt','termsAccepted','consentVersion','professionalDetails'])
          && d.keys().hasOnly(['legalName','nicNumber','address','businessName','emergencyPhone','experienceYears','services','vehicleTypes','documents','revision','submittedAt','termsAccepted','consentVersion','professionalDetails','customServices'])
          && validCustomServices(d.get('customServices', []), d.services)
          && ((resource != null && resource.data.get('professionalDetails', {}) == d.professionalDetails && resource.data.services == d.services) || validProfessional(d.professionalDetails, d.services))
          && d.legalName is string && d.legalName.size() >= 2 && d.legalName.size() <= 100
          && d.nicNumber is string && d.nicNumber.matches('([0-9]{9}[VX]|[0-9]{12})')
          && d.address is string && d.address.size() >= 5 && d.address.size() <= 300
          && d.businessName is string && d.businessName.size() <= 100
          && d.emergencyPhone is string && (d.emergencyPhone == '' || d.emergencyPhone.matches('[+]947[0-9]{8}'))
          && d.experienceYears is int && d.experienceYears >= 0 && d.experienceYears <= 60
          && d.services is list && d.services.size() > 0 && d.services.size() <= 4 && d.services.hasOnly(['General Mechanic','Vehicle Towing','Flat Tyre','Battery Jumpstart'])
          && d.vehicleTypes is list && d.vehicleTypes.size() > 0 && d.vehicleTypes.size() <= 5 && d.vehicleTypes.hasOnly(['Sedan / Hatchback','SUV','Van','Motorcycle','Other'])
          && d.documents is map && d.documents.keys().hasAll(['nicFront','nicBack','selfie','serviceProof'])
          && d.documents.keys().hasOnly(['nicFront','nicBack','selfie','serviceProof','recoveryProof','businessProof'])
          && validDocument(d.documents.nicFront) && validDocument(d.documents.nicBack)
          && validDocument(d.documents.selfie) && validDocument(d.documents.serviceProof)
          && (!('recoveryProof' in d.documents) || validDocument(d.documents.recoveryProof))
          && (!d.services.hasAny(['Vehicle Towing']) || 'recoveryProof' in d.documents)
          && (!('businessProof' in d.documents) || validDocument(d.documents.businessProof))
          && (d.professionalDetails.providerType != 'business' || 'businessProof' in d.documents)
          && d.revision is int && d.submittedAt == request.time && d.termsAccepted == true && d.consentVersion == 1;
      }
      function correctionOnly() {
        let review = get(/databases/$(database)/documents/accountModeration/$(uid)).data;
        let correction = review.get('correctionRequest', {});
        return !('correctionRequest' in review) || (correction.get('revision', -1) == resource.data.revision &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['documents','revision','submittedAt'])
          && request.resource.data.documents.keys().hasAll(correction.documents)
          && request.resource.data.documents.diff(resource.data.documents).affectedKeys().hasOnly(correction.documents)
          && request.resource.data.documents.diff(resource.data.documents).affectedKeys().hasAll(correction.documents));
      }
      allow read: if (authenticated() && request.auth.uid == uid) || canReviewProviders();
      allow create: if owner() && valid() && request.resource.data.revision == 1;
      function hasCorrection() {
        return exists(/databases/$(database)/documents/accountModeration/$(uid))
          && 'correctionRequest' in get(/databases/$(database)/documents/accountModeration/$(uid)).data;
      }
      function validCorrectedDocuments() {
        let d = request.resource.data.documents;
        return d is map && d.keys().hasAll(['nicFront','nicBack','selfie','serviceProof'])
          && d.keys().hasOnly(['nicFront','nicBack','selfie','serviceProof','recoveryProof','businessProof'])
          && validDocument(d.nicFront) && validDocument(d.nicBack) && validDocument(d.selfie) && validDocument(d.serviceProof)
          && (!('recoveryProof' in d) || validDocument(d.recoveryProof))
          && (!('businessProof' in d) || validDocument(d.businessProof));
      }
      function withdrawApplication() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicationStatus','withdrawnAt'])
          && resource.data.get('applicationStatus','submitted') != 'withdrawn'
          && request.resource.data.get('applicationStatus','submitted') == 'withdrawn'
          && request.resource.data.withdrawnAt == request.time
          && (!exists(/databases/$(database)/documents/accountModeration/$(uid))
            || get(/databases/$(database)/documents/accountModeration/$(uid)).data.verification == 'pending');
      }
      function resubmitApplication() {
        let withdrawn = resource.data.get('applicationStatus','submitted') == 'withdrawn';
        let selected = !withdrawn && hasCorrection();
        return request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.submittedAt == request.time
          && (selected ? (
            get(/databases/$(database)/documents/accountModeration/$(uid)).data.verification == 'pending'
            && correctionOnly() && validCorrectedDocuments()) : (
            (withdrawn || !('professionalDetails' in resource.data) || (
              exists(/databases/$(database)/documents/accountModeration/$(uid))
              && get(/databases/$(database)/documents/accountModeration/$(uid)).data.verification == 'pending'
              && get(/databases/$(database)/documents/accountModeration/$(uid)).data.updatedAt > resource.data.submittedAt))
            && valid()));
      }
      allow update: if owner() && request.auth.token.get('email_verified', false) == true
        && (withdrawApplication() || resubmitApplication());
      allow delete: if false;
    }
    function validCustomService(d, services) {
      return d is map && d.keys().hasAll(['name','description','category'])
        && d.keys().hasOnly(['name','description','category'])
        && d.name is string && d.name.size() >= 3 && d.name.size() <= 60
        && d.description is string && d.description.size() >= 10 && d.description.size() <= 160
        && d.category is string && d.category in services;
    }
    function validCustomServices(items, services) {
      return items is list && items.size() <= 5
        && (items.size() < 1 || validCustomService(items[0], services))
        && (items.size() < 2 || validCustomService(items[1], services))
        && (items.size() < 3 || validCustomService(items[2], services))
        && (items.size() < 4 || validCustomService(items[3], services))
        && (items.size() < 5 || validCustomService(items[4], services));
    }
    function validDocument(value) { return value is string && value.size() > 20 && value.size() <= 160000; }
    match /providerApprovalEmails/{id} { allow read: if canReviewProviders(); allow write: if false; }
    match /appSettings/{id} {
      allow read: if authenticated();
      allow create, update: if id == 'operations' && superAdmin()
        && request.resource.data.keys().hasAll(['maintenance','notice','coverage','enabledServices','reason','updatedAt','updatedBy','lastAuditId'])
        && request.resource.data.keys().hasOnly(['maintenance','notice','coverage','enabledServices','reason','updatedAt','updatedBy','lastAuditId'])
        && request.resource.data.maintenance is bool
        && request.resource.data.notice is string && request.resource.data.notice.size() <= 300
        && request.resource.data.coverage is string && request.resource.data.coverage.size() <= 300
        && request.resource.data.enabledServices is list && request.resource.data.enabledServices.size() <= 4
        && request.resource.data.enabledServices.hasOnly(['General Mechanic','Vehicle Towing','Flat Tyre','Battery Jumpstart'])
        && request.resource.data.reason is string && request.resource.data.reason.size() >= 10 && request.resource.data.reason.size() <= 500
        && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.lastAuditId is string
        && (resource == null || request.resource.data.lastAuditId != resource.data.lastAuditId)
        && validAudit(request.resource.data.lastAuditId, 'settings', id);
      allow delete: if false;
    }

    function validAudit(id, kind, target) {
      let a = getAfter(/databases/$(database)/documents/adminAudit/$(id)).data;
      return a.actor == request.auth.uid && a.kind == kind && a.target == target && a.createdAt == request.time;
    }

    function validCorrection(uid, d) {
      let c = d.correctionRequest;
      let app = get(/databases/$(database)/documents/providerApplications/$(uid)).data;
      return c is map && c.keys().hasOnly(['revision','documents','requestedAt'])
        && c.keys().hasAll(['revision','documents','requestedAt'])
        && c.revision is int && c.documents is list && c.documents.size() > 0 && c.documents.size() <= 6
        && c.documents.toSet().size() == c.documents.size()
        && c.documents.hasOnly(['selfie','nicFront','nicBack','serviceProof','businessProof','recoveryProof'])
        && c.requestedAt is timestamp
        && ((resource != null && c == resource.data.get('correctionRequest', {})) || (
          d.verification == 'pending' && c.requestedAt == request.time && c.revision == app.revision
          && app.get('applicationStatus','submitted') != 'withdrawn'));
    }
    match /accountModeration/{uid} {
      allow read: if (authenticated() && request.auth.uid == uid) || isAdmin();
      allow create, update: if isAdmin()
        && (superAdmin() || (canReviewProviders() && hasRole(uid, 'provider')))
        && exists(/databases/$(database)/documents/users/$(uid))
        && request.resource.data.keys().hasAll(['status','verification','flagged','reason','updatedBy','updatedAt','lastAuditId'])
        && request.resource.data.keys().hasOnly(['status','verification','flagged','reason','updatedBy','updatedAt','lastAuditId','verificationRevision','validUntil','verificationChecks','correctionRequest'])
        && (!('correctionRequest' in request.resource.data) || validCorrection(uid, request.resource.data))
        && request.resource.data.status in ['active','suspended']
        && request.resource.data.verification in ['pending','verified','rejected']
        && request.resource.data.flagged is bool
        && request.resource.data.reason is string && request.resource.data.reason.size() >= 10 && request.resource.data.reason.size() <= 500
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time
        && request.resource.data.lastAuditId is string
        && (resource == null || request.resource.data.lastAuditId != resource.data.lastAuditId)
        && (uid != request.auth.uid || (request.resource.data.status == 'active' && request.resource.data.verification != 'rejected'))
        && (hasRole(uid, 'provider') || request.resource.data.verification == 'pending')
        && (request.resource.data.verification != 'verified' || (
          exists(/databases/$(database)/documents/providerApplications/$(uid))
          && get(/databases/$(database)/documents/providerApplications/$(uid)).data.get('applicationStatus', 'submitted') != 'withdrawn'
          && validProfessional(get(/databases/$(database)/documents/providerApplications/$(uid)).data.professionalDetails, get(/databases/$(database)/documents/providerApplications/$(uid)).data.services)
          && (resource == null || resource.data.get('correctionRequest', {}).get('revision', -1) != get(/databases/$(database)/documents/providerApplications/$(uid)).data.revision)
          && request.resource.data.verificationRevision == get(/databases/$(database)/documents/providerApplications/$(uid)).data.revision
          && request.resource.data.validUntil is timestamp && request.resource.data.validUntil > request.time && request.resource.data.validUntil <= request.time + duration.value(366, 'd')
          && request.resource.data.verificationChecks is list && request.resource.data.verificationChecks.size() == 4 && request.resource.data.verificationChecks.hasAll(['identity','face','capability','contact'])))
        && validAudit(request.resource.data.lastAuditId, 'account', uid);
      allow delete: if false;
    }
    match /complaintReviews/{id} {
      function job() { return get(/databases/$(database)/documents/requests/$(id)).data; }
      allow read: if isAdmin() || (signedIn() && (job().driverId == request.auth.uid || job().providerId == request.auth.uid));
      allow create, update: if isAdmin()
        && exists(/databases/$(database)/documents/requests/$(id)/disputes/case)
        && request.resource.data.keys().hasAll(['status','priority','assignedTo','decision','updatedAt','lastAuditId'])
        && request.resource.data.keys().hasOnly(['status','priority','assignedTo','decision','updatedAt','lastAuditId','dueAt'])
        && request.resource.data.status in ['under_review','resolved','dismissed']
        && request.resource.data.priority in ['low','normal','high','urgent']
        && request.resource.data.assignedTo == request.auth.uid
        && request.resource.data.decision is string && request.resource.data.decision.size() >= 10 && request.resource.data.decision.size() <= 500
        && request.resource.data.updatedAt == request.time && request.resource.data.lastAuditId is string
        && (resource == null || request.resource.data.lastAuditId != resource.data.lastAuditId)
        && canSupport()
        && (!('dueAt' in request.resource.data) || (request.resource.data.dueAt is timestamp && request.resource.data.dueAt > request.time && request.resource.data.dueAt <= request.time + duration.value(31, 'd')))
        && validAudit(request.resource.data.lastAuditId, 'complaint', id);
      match /history/{eventId} {
        function reviewJob() { return get(/databases/$(database)/documents/requests/$(id)).data; }
        allow read: if isAdmin() || (signedIn() && (reviewJob().driverId == request.auth.uid || reviewJob().providerId == request.auth.uid));
        allow create: if canSupport() && isAdmin()
          && getAfter(/databases/$(database)/documents/complaintReviews/$(id)).data.lastAuditId == eventId
          && request.resource.data.keys().hasOnly(['status','decision','createdAt'])
          && request.resource.data.status == getAfter(/databases/$(database)/documents/complaintReviews/$(id)).data.status
          && request.resource.data.decision == getAfter(/databases/$(database)/documents/complaintReviews/$(id)).data.decision
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      allow delete: if false;
    }
    match /adminAudit/{id} {
      function paired(collection) {
        let path = /databases/$(database)/documents/$(collection)/$(request.resource.data.target);
        let after = getAfter(path).data;
        return after.lastAuditId == id && request.resource.data.after == after
          && request.resource.data.before == (exists(path) ? get(path).data : {})
          && request.resource.data.reason == (collection == 'complaintReviews' ? after.decision : after.reason);
      }
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['kind','target','actor','reason','before','after','createdAt'])
        && request.resource.data.keys().hasOnly(['kind','target','actor','reason','before','after','createdAt'])
        && request.resource.data.actor == request.auth.uid && request.resource.data.createdAt == request.time
        && request.resource.data.target is string
        && ((request.resource.data.kind == 'account' && (superAdmin() || canReviewProviders()) && paired('accountModeration'))
          || (request.resource.data.kind == 'complaint' && canSupport() && paired('complaintReviews'))
          || (request.resource.data.kind == 'settings' && superAdmin() && paired('appSettings')));
      allow update, delete: if false;
    }
    match /adminAccess/{uid} {
      allow read: if (authenticated() && request.auth.uid == uid) || isAdmin();
      allow write: if false;
    }
    match /adminNotes/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['kind','target','text','actor','createdAt'])
        && request.resource.data.keys().hasOnly(['kind','target','text','actor','createdAt'])
        && request.resource.data.kind in ['account','complaint']
        && request.resource.data.target is string
        && request.resource.data.text is string && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 500
        && request.resource.data.actor == request.auth.uid && request.resource.data.createdAt == request.time
        && ((request.resource.data.kind == 'account' && exists(/databases/$(database)/documents/users/$(request.resource.data.target)))
          || (request.resource.data.kind == 'complaint' && exists(/databases/$(database)/documents/requests/$(request.resource.data.target)/disputes/case)));
      allow update,delete: if false;
    }
    match /adminProvisioning/{id} { allow read: if isAdmin(); allow write: if false; }
    match /{path=**}/disputes/{id} { allow read: if isAdmin(); }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isProvider() {
      return authenticated() && request.auth.token.get('email_verified', false) == true
        && !accountBlocked(request.auth.uid) && hasRole(request.auth.uid, 'provider')
        && providerApproved(request.auth.uid);
    }

    function isDriver() {
      return signedIn() && hasRole(request.auth.uid, 'driver');
    }

    match /users/{userId} {
      function validName(d) { return d.displayName is string && d.displayName.size() >= 2 && d.displayName.size() <= 100; }
      function validEmail(d) { return d.email is string && d.email.size() <= 254
        && d.email.matches('[^ @]+@[^ @]+[.][^ @]+') && d.email.lower() == request.auth.token.get('email', '').lower(); }
      function validPhone(d) { return d.phone is string && d.phone.matches('[+]947[0-9]{8}'); }
      function validRoles(d) { return d.get('roles', [d.role]) is list
        && d.get('roles', [d.role]).size() >= 1 && d.get('roles', [d.role]).size() <= 2
        && d.get('roles', [d.role]).hasOnly(['driver', 'provider'])
        && d.role in d.get('roles', [d.role])
        && d.get('lastRole', d.role) in d.get('roles', [d.role]); }
      allow create: if authenticated() && !accountBlocked(userId) && request.auth.uid == userId
        && request.resource.data.role in ['driver','provider']
        && validName(request.resource.data) && validEmail(request.resource.data)
        && validPhone(request.resource.data) && validRoles(request.resource.data)
        && request.resource.data.get('online', false) == false
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow read: if isAdmin() || (authenticated() && request.auth.uid == userId);
      allow update: if authenticated() && !accountBlocked(userId)
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName']) || validName(request.resource.data))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email']) || validEmail(request.resource.data))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone']) || validPhone(request.resource.data))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles','lastRole'])
          || (validRoles(request.resource.data)
            && request.resource.data.get('roles', [resource.data.role]).hasAll(resource.data.get('roles', [resource.data.role]))))
        && (request.resource.data.get('online', false) == false
          || (request.auth.token.get('email_verified', false) == true && hasRole(userId, 'provider') && providerApproved(userId)));
      allow delete: if signedIn() && request.auth.uid == userId;

      match /devices/{deviceId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
      match /vehicles/{vehicleId} {
        function ownsVehicle() {
          return signedIn() && request.auth.uid == userId && isDriver();
        }
        function validVehicle() {
          let v = request.resource.data;
          return v.keys().hasAll(['make', 'model', 'year', 'vehicleType',
              'registration', 'fuelType', 'transmission', 'archived', 'createdAt', 'updatedAt'])
            && v.keys().hasOnly(['make', 'model', 'year', 'vehicleType',
              'registration', 'fuelType', 'transmission', 'photoData', 'archived', 'createdAt', 'updatedAt'])
            && v.make is string && v.make.size() > 0 && v.make.size() <= 40
            && v.model is string && v.model.size() > 0 && v.model.size() <= 40
            && v.year is int && v.year >= 1950 && v.year <= request.time.year() + 1
            && v.vehicleType in ['Sedan / Hatchback', 'SUV', 'Van', 'Motorcycle', 'Other']
            && v.registration is string && v.registration.size() > 0 && v.registration.size() <= 16
            && v.fuelType in ['Petrol', 'Diesel', 'Hybrid', 'Electric', 'Other']
            && v.transmission in ['Automatic', 'Manual', 'Other']
            && (!('photoData' in v) || (v.photoData is string && v.photoData.size() <= 210000))
            && v.archived is bool && v.createdAt is timestamp
