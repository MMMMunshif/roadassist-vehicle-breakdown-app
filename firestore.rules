        && request.resource.data.get('workStartMinute',0) is int && request.resource.data.get('workStartMinute',0) >= 0 && request.resource.data.get('workStartMinute',0) < 1440
        && request.resource.data.get('workEndMinute',0) is int && request.resource.data.get('workEndMinute',0) >= 0 && request.resource.data.get('workEndMinute',0) < 1440
        && request.resource.data.get('hoursOverrideUntil',request.time) is timestamp && request.resource.data.get('hoursOverrideUntil',request.time) <= request.time + duration.value(125,'m')
        && request.resource.data.verified == true
        && request.resource.data.verificationExpiresAt == get(/databases/$(database)/documents/accountModeration/$(providerId)).data.validUntil
        && request.resource.data.services is list && request.resource.data.services.size() > 0 && request.resource.data.services.hasOnly(get(/databases/$(database)/documents/providerApplications/$(providerId)).data.services)
        && request.resource.data.vehicleTypes is list && request.resource.data.vehicleTypes.size() > 0 && request.resource.data.vehicleTypes.hasOnly(get(/databases/$(database)/documents/providerApplications/$(providerId)).data.vehicleTypes)
        && (resource == null
