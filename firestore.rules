        (resource.data.providerId is string
          && resource.data.status in ['accepted','en_route']
          && (resource.data.providerId == request.auth.uid ||
            (resource.data.driverId == request.auth.uid && resource.data.status == 'accepted'
             && resource.data.acceptedAt is timestamp && request.time >= resource.data.acceptedAt + duration.value(10,'m')))
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledBy == request.auth.uid
          && request.resource.data.cancellationType == (resource.data.providerId == request.auth.uid ? 'provider_withdrawal' : 'departure_timeout')
