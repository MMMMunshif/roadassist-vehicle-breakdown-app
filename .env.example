# Add these values in Vercel Project Settings > Environment Variables.
# Never commit the real values.
FIREBASE_PROJECT_ID=roadassist-lk-munshif
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@roadassist-lk-munshif.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# PayHere checkout (use sandbox credentials for testing first).
PAYHERE_MERCHANT_ID=your-payhere-merchant-id
PAYHERE_MERCHANT_SECRET=your-payhere-merchant-secret
PAYHERE_SANDBOX=true
# Public HTTPS Vercel URL; PayHere must be able to reach this webhook.
PAYMENT_PUBLIC_BASE_URL=https://your-project.vercel.app
PAYMENT_RETURN_URL=https://your-project.vercel.app
PAYMENT_CANCEL_URL=https://your-project.vercel.app
